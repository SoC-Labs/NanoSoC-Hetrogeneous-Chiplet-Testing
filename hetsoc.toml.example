# =============================================================================
# hetsoc.toml — bench description for the NanoSoC heterogeneous chiplet pair.
#
# Copy to ./hetsoc.toml (or point $HETSOC_CONFIG at it) and edit the two board
# addresses. Search order, first hit wins (configs are NOT merged — a
# half-merged address map is more dangerous than a missing one):
#
#     $HETSOC_CONFIG   ->   ./hetsoc.toml   ->   ~/.config/hetsoc.toml
#
# >>> THE ONE THING TO GET RIGHT <<<
# `role` decides which bitstream belongs on which board: die_a is the
# master/grandmaster, die_b the slave, and the two images are MIRRORED. The same
# image on both boards drives two outputs onto every J21 ribbon lane. Everything
# else in this file is recoverable; that is not.
#
# Copyright (C) 2026, SoC Labs (www.soclabs.org)
# =============================================================================

# -----------------------------------------------------------------------------
# Pairs. `hetsoc <cmd>` uses [pair.default] unless you pass --pair NAME.
# -----------------------------------------------------------------------------
[pair.default]
# The heterogeneous pair this repo exists to test: eth chiplet <-> compute
# chiplet. Compute's KR260 bitstream is now BUILT and the target is resolved (see
# [target.kr260-compute-chiplet] below). DIRECTION: eth is die_a and ORIGINATES;
# compute is die_b and RECEIVES only (its PS backdoor cannot master off-die — H2).
a = "eth"
b = "compute"
description = "eth chiplet (die_a, originator) -> compute chiplet (die_b, receiver) over J21"

[pair.eth-homogeneous]
# The pair that IS proven on silicon (2026-07-27..29): eth die_a <-> eth die_b.
# Use this to sanity-check the bench itself before blaming the het pair.
a = "eth"
b = "eth_b"
description = "homogeneous eth<->eth control pair (proven on silicon)"

# -----------------------------------------------------------------------------
# Boards.
#   host           ssh destination; a bare IP gets the `ubuntu` user
#   fpgahub        fpgahub board name — REQUIRED for POR recovery and deploy
#   target         a name from the hetsoc.targets registry (`hetsoc targets`)
#   role           die_a (master/grandmaster) | die_b (slave)
#   password       optional; prefer $HETSOC_PASSWORD / $KR260_PASSWORD, or ssh keys
#   transport      ssh-agent (default, one persistent connection) | ssh-oneshot
#   deploy_command optional; overrides the target's fpgahub deploy action.
#                  {host} {role} {name} {fpgahub} {target} are substituted.
#   timeout_s      per-operation wall-clock bound; a hang raises WedgeDetected
# -----------------------------------------------------------------------------
[board.eth]
host = "ubuntu@10.22.24.159"
fpgahub = "kr260_01"
target = "kr260-eth-chiplet"
role = "die_a"

[board.compute]
host = "ubuntu@10.22.24.153"
fpgahub = "kr260_02"
target = "kr260-compute-chiplet"
role = "die_b"

[board.eth_b]
# The die_b half of the homogeneous control pair — the same bitstream family,
# the mirrored (-flip) image.
host = "ubuntu@10.22.24.153"
fpgahub = "kr260_02"
target = "kr260-eth-chiplet"
role = "die_b"

# -----------------------------------------------------------------------------
# Target overrides — the per-design escape hatch from CHIPLET_HOST_TOOLING_PLAN.md.
# This is the ONLY supported way to give a target a different address window,
# deliberately, so a value that can wedge a board lands in a reviewable file
# next to its citation instead of in a script literal.
#
# >>> COMPUTE CHIPLET: KR260 BITSTREAM BUILT 2026-07-31 — window CONFIRMED <<<
# kr260-compute-chiplet (die_b) + kr260-compute-chiplet-flip (die_a) both build
# clean (write_bitstream Complete, 0 critical warnings, WNS +12.30ns). The PS
# backdoor window base is now CONFIRMED from the built .hwh (no longer a guess),
# so the block below carries REAL values + citation. It STAYS COMMENTED so copying
# this template can't silently apply a window override to the wrong board —
# UNCOMMENT it (or put it in your own hetsoc.toml) when you actually run the pair.
# See docs/ETH_COMPUTE_BRINGUP.md.
#
# RECEIVE-ONLY over the PS backdoor. ps_m (the PS host initiator) deliberately
# EXCLUDES d2d0/d2d1 (H2 down-link safety, nanosoc_compute_soc.yaml:1106-1123), so
# the compute PS CANNOT originate a peer write or program its own CAM — MEASURED
# ps_reaches_d2d=False (2026-07-30 het_pair sim). Drive the pair
# eth(die_a) -> compute(die_b): eth originates; compute RECEIVES into shared_sram
# (0x2D) / ipc_mailbox (0x2A) and reads it back through its own PS window (ps_m DOES
# reach shared_sram). compute->eth is NOT possible without lifting the H2 gate.
# [target.kr260-compute-chiplet]
# window_base = 0x400000000        # .hwh MEMRANGE, CONFIRMED (not by analogy)
# window_size = 0x100000000        # 4 GiB high aperture -> de-provisionalises to_host()
# source = "NanoSoC-Compute-Chiplet/tidelink/imp/fpga/output/kr260-compute-chiplet/tidelink.hwh MEMRANGE INSTANCE=nanosoc_compute_chiplet_0 C_BASEADDR BASEVALUE=0x400000000 HIGHVALUE=0x4FFFFFFFF (built 2026-07-31, tidelink 74c6777); peer 0x41 = chiplet_d2d_decode.sv haddr[24] split; ps_reaches_d2d=False measured 2026-07-30 het_pair sim"
#
# peer_aperture (0x41), tlapb_base (0x40030000), inbound bytes (SRAM 0x2D / mbox
# 0x2A), d2d_links, roles, and ps_reaches_d2d=False are INHERITED from the registry
# descriptor (host/hetsoc/targets.py) — do not repeat them here. Link 0 (which
# carries the TideChart) is the J21 default; link 1 is tied off. NOTE: peer 0x41 is
# the post-G4 INTENDED value; it only matters if compute originates (it does not in
# eth->compute), so it stays unverified-in-path but harmless for this pairing.

# -----------------------------------------------------------------------------
# Defaults applied to every board unless the board overrides them.
# -----------------------------------------------------------------------------
[defaults]
transport = "ssh-agent"
timeout_s = 20.0
