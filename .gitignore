# Site-specific: board addresses on a different rig, ssh proxy, passwords.
# set_env.sh sources site.local.sh FIRST so its values win. Keeping it out of
# git is what lets the published repo carry no internal network topology and no
# credentials — the same split as tidelink's fpga/site.local.mk.
site.local.sh
hetsoc.local.toml

